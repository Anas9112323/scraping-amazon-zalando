# Pipeline Scraping Marques FR — Config
# Copie ce fichier en .env et remplis les valeurs

# ═══════════════════════════════════════════════
# SerpAPI (RECOMMANDÉ — 100 recherches/mois gratuites)
# Inscris-toi sur https://serpapi.com/ → copie ta clé API
# Sans cette clé, le pipeline tourne en mode dégradé (fallback)
# ═══════════════════════════════════════════════
SERPAPI_KEY=

# ═══════════════════════════════════════════════
# Google Sheets (optionnel — le CSV marche sans)
# Voir pipeline/sheets.py pour le setup complet
# ═══════════════════════════════════════════════
# Mets le fichier google_creds.json dans pipeline/

# ═══════════════════════════════════════════════
# Slack notification (optionnel)
# ═══════════════════════════════════════════════
SLACK_WEBHOOK_URL=

# ═══════════════════════════════════════════════
# Batch size (nombre de marques par jour)
# ═══════════════════════════════════════════════
BATCH_SIZE=10
